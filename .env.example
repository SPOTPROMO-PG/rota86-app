# Copie para .env e preencha — NUNCA commite o .env real.
# Ver docs/ORIGEM_DOS_DADOS.md e docs/ARQUITETURA.md para contexto.

DB_SERVER=172.18.0.59
DB_DATABASE=bi_pg_promotores

# Usuário técnico dedicado (recomendado) — NÃO usar uma conta pessoal de
# domínio aqui. Se deixar em branco, o app tenta autenticação integrada do
# Windows (só funciona se o PHP rodar sob uma identidade Windows com acesso
# ao SQL Server — típico em IIS, não em hosting Linux compartilhado).
DB_USER=
DB_PASSWORD=
